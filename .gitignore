# --- Top-level Firmware-Build (CMake/Pico-SDK) ---
# Inhalt von Top-Level build/ ignorieren, fertige UF2 explizit behalten
# (committed damit der Pi ohne Re-Build flashen kann).
build/*
!build/Hexapod_servo_driver.uf2
_deps/
CMakeCache.txt
CMakeFiles/
*.o
*.elf
*.elf.map
*.bin
*.hex
*.dis

# --- colcon-Artefakte ---
# Dieses Repo ist KEIN ROS-Workspace. Falls dennoch jemand `colcon build`
# in einem Subdir aufruft (passierte in tools/), legt colcon trotzdem
# diese drei Verzeichnisse an (mit COLCON_IGNORE-Marker) — alles regenerierbar.
tools/build/
tools/install/
tools/log/
python_tests/build/
python_tests/install/
python_tests/log/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- IDE / Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Backups / ad-hoc ---
*.bak
*.backup

# --- OS-spezifisch ---
Thumbs.db
desktop.ini
